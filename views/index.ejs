    </div>

    <%- include("footer.ejs") %>

   <script>
    // CUSTOM CURSOR HERE
    if (window.innerWidth > 1024) {
    const cursor = document.querySelector('.custom-cursor');
    document.addEventListener('mousemove', (e) => {
        cursor.style.top = `${e.clientY}px`;
        cursor.style.left = `${e.clientX}px`;
    });
    }

    // HERO TEXT HERE
    var i = 0;
    var txt = 'Web Developer'; 
    var speed = 100;

    function letter() {
    if (i < txt.length) {
        document.getElementById("lettering").innerHTML += txt.charAt(i);
        i++;
        setTimeout(letter, speed);
    }
    }

    letter();

    // CONTACT INFO HERE
    function contact() {
        const contactInfo = document.getElementById("footer");
        contactInfo.classList.add("show");
    }

    function closeContact() {
        const contactInfo = document.getElementById("footer");
        contactInfo.classList.remove("show");
    }

    // SKILLS SECTION MOBILE HERE
    if (window.innerWidth <= 1024) {
        const skillsTitles = document.querySelectorAll('.skills_inner .title');

        skillsTitles.forEach(title => {
            title.addEventListener('click', function () {

                skillsTitles.forEach(otherTitle => {
                    if (otherTitle !== this) {
                        otherTitle.nextElementSibling.classList.remove('showText');
                        otherTitle.classList.remove('active');
                    }
                });
                this.nextElementSibling.classList.toggle('showText');
                this.classList.toggle('active');
            });
        });
    }

    // MOBILE MENU HERE
    function mobileMenu() {
        const mobileMenuOpen = document.querySelector(".header_main_mobile");
        mobileMenuOpen.classList.toggle("show");
        const burgenIcon = document.querySelector(".burger");
        burgenIcon.classList.toggle("show");
    }

    const mobileMenuItems = document.querySelector('.header_main_mobile');
    const menuItems = mobileMenuItems.querySelectorAll('a, span'); 
    menuItems.forEach(item => {
        item.addEventListener('click', () => {
            mobileMenuItems.classList.remove('show');
            const burgenIcon = document.querySelector(".burger");
            burgenIcon.classList.toggle("show");
        });
    });



   </script> 
 
</body>
</html>