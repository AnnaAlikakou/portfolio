       </div>
       <div class="skills_inner">
        <p class="title">Backend & Server-Side</p>
        <ul class="hidden_text">
            <li>PHP</li>
            <li>Node.js</li>
            <li>Express.js</li>
            <li>Server Configuration (basic)</li>
        </ul>
       </div>
       <div class="skills_inner">
        <p class="title">Databases</p>
        <ul class="hidden_text">
            <li>SQL</li>
            <li>PostgreSQL</li>
            <li>Database Fundamentals</li>
        </ul>
       </div>
       <div class="skills_inner">
        <p class="title">Frameworks & Libraries</p>
        <ul class="hidden_text">
            <li>JQuery</li>
